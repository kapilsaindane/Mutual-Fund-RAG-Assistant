# Environment Variables for Retrieval System
# Copy this file to .env and fill in your actual values

# Groq API Key (for LLM-powered answer generation)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Force Groq usage (set to 'true' to always use Groq)
# If not set, system will auto-detect based on API key presence
USE_GROQ=true

# Optional: Override Groq model (default: llama3-70b-8192)
GROQ_MODEL=llama3-70b-8192

# Optional: Log level for debugging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Maximum number of retrieved documents (default: 10)
MAX_RETRIEVED_DOCS=10

# Optional: Temperature for Groq generation (default: 0.1)
GROQ_TEMPERATURE=0.1

# Optional: Maximum tokens for Groq responses (default: 150)
GROQ_MAX_TOKENS=150

# Optional: Sentence count limit for extractive generation (default: 3)
MAX_SENTENCES=3

# Optional: Enable/disable PII detection (default: true)
ENABLE_PII_DETECTION=true

# Optional: Enable/disable URL policy enforcement (default: true)
ENABLE_URL_POLICY=true

# Optional: Path to sources registry (auto-detected if not set)
SOURCES_REGISTRY_PATH=docs/phases/phase-1/source-registry.json

# Optional: Path to embeddings file (auto-detected if not set)
EMBEDDINGS_PATH=ingestion/phase-2/2.5-embedder/output/embeddings-latest.json

# Optional: Path to ChromaDB data (auto-detected if not set)
CHROMA_PATH=ingestion/phase-2/2.6-indexerr/chroma-data
